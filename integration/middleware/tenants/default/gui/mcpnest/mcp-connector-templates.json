{
  "version": 1,
  "templates": [
    {
      "id": "manual",
      "name": "Other / Manual MCP",
      "category": "Custom",
      "icon": "fa-sliders",
      "iconClass": "fa-solid fa-screwdriver-wrench",
      "description": "Enter the MCP endpoint and authentication details manually.",
      "mcpAlias": "",
      "mcpName": "",
      "endpointUrl": "",
      "endpointPlaceholder": "https://mcp.example.com/api/v1/connect",
      "endpointType": "STANDARD",
      "authType": "NONE",
      "authFlow": "manual",
      "authFields": []
    },
    {
      "id": "gmail-zapier",
      "name": "Gmail via Zapier MCP",
      "category": "Productivity",
      "icon": "fa-envelope",
      "iconClass": "fa-solid fa-envelope-open-text",
      "description": "Gmail tools exposed through a Zapier MCP connection URL. Paste the Zapier MCP token or full connect URL.",
      "mcpAlias": "gmail",
      "mcpName": "Gmail",
      "endpointUrl": "https://mcp.zapier.com/api/v1/connect?token={connectionToken}",
      "endpointPlaceholder": "https://mcp.zapier.com/api/v1/connect?token=...",
      "endpointType": "STREAMABLE_HTTP",
      "authType": "NONE",
      "authFlow": "sso",
      "authUrl": "https://mcp.zapier.com/",
      "authFields": [
        {
          "key": "connectionToken",
          "label": "Zapier MCP token",
          "type": "password",
          "target": "endpointToken",
          "required": true,
          "placeholder": "Paste token from Zapier MCP connection URL"
        }
      ]
    },
    {
      "id": "github",
      "name": "GitHub MCP",
      "category": "Developer",
      "icon": "fa-code-branch",
      "iconClass": "fa-brands fa-github",
      "description": "GitHub repository, issue, pull request, and code workflow tools. Use an issued remote MCP endpoint or a bearer token gateway.",
      "mcpAlias": "github",
      "mcpName": "GitHub",
      "endpointUrl": "",
      "endpointPlaceholder": "Paste your GitHub MCP endpoint URL",
      "endpointType": "STREAMABLE_HTTP",
      "authType": "BEARER",
      "authFlow": "sso",
      "authUrl": "https://github.com/login/oauth/authorize",
      "authFields": [
        {
          "key": "bearerToken",
          "label": "GitHub bearer token",
          "type": "password",
          "target": "authInfo.bearerToken",
          "required": false,
          "placeholder": "Paste token if your endpoint requires bearer auth"
        }
