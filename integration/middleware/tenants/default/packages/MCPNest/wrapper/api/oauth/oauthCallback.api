        "dropList" : [ ],
        "createList" : [ {
          "path" : "html",
          "value" : "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>OAuth Callback Handler</title>\n</head>\n<body>\n    <p>Processing authentication, please wait...</p>\n\n    <textarea id=\"jsonPayloadSource\" hidden style=\"display: none;\">#{jsonString}</textarea>\n\n    <script>\n        try {\n            var textareaElement = document.getElementById(\"jsonPayloadSource\");\n            var rawJsonString = textareaElement.value;\n            var jsonObject = JSON.parse(rawJsonString);\n\n            // Verify if the parent window is available\n            if (window.opener) {\n                \n                // Construct a message signature so your parent page knows this is the right data\n                var messagePayload = {\n                    type: \"OAUTH_CALLBACK_DATA\",\n                    data: jsonObject\n                };\n\n                // Securely stream the data to the parent window. \n                // Replace '*' with your explicit frontend domain (e.g. \"https://yourfrontend.com\") for strict security.\n                window.opener.postMessage(messagePayload, \"*\");\n                \n                // Close the popup window now that the data pipeline is triggered\n                window.close();\n                \n            } else {\n                console.error(\"Error: Parent window context not found.\");\n            }\n        } catch (error) {\n            console.error(\"Error parsing JSON payload:\", error);\n        }\n    </script>\n</body>\n</html>\n",
          "id" : "dc1491e8-8676-4b86-9c19-80b2ab1fa7dd",
          "evaluate" : "EEV",
          "typePath" : "string"
        }, {
          "path" : "ContentType",
          "value" : "text/html; charset=utf-8",
          "id" : "dc4237b6-2a8d-4439-b6a4-383c10932cb8",
          "typePath" : "string"
        } ],
