    "api_info" : {
      "title" : "Update Schema By UUID",
      "description" : "Updates the schema of an existing tool in the tool registry using its unique identifier. This operation allows modifying the tool’s input/output structure without affecting other configurations.\n\nInput Parameters:\nuuid (string): Unique identifier of the tool whose schema needs to be updated.\nschema (object/string): Updated schema defining the tool’s input and output structure.\nOutput Parameters:\nstatus (string): Status of the operation (e.g., success or failure).\nerror (string): Error message in case the update fails."
    },
