    "api_info" : {
      "title" : "Update Static Payload By UUID",
      "description" : "pdates the static payload of an existing tool in the tool registry using its unique identifier. This operation allows modifying predefined request data without affecting other tool configurations.\n\nInput Parameters:\nuuid (string): Unique identifier of the tool whose static payload needs to be updated.\nstaticPayload (object/string): Updated static payload associated with the tool.\nOutput Parameters:\nstatus (string): Status of the operation (e.g., success or failure).\nerror (string): Error message in case the update fails."
    },
