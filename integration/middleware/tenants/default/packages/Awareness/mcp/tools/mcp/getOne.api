    "api_info" : {
      "title" : "Get one",
      "description" : "Retrieves details of a specific MCP entry using its unique identifier. This operation returns the complete configuration and metadata of the requested MCP.\n\nInput Parameters:\nid (string): Unique identifier of the MCP to be retrieved.\nOutput Parameters:\nmcp (object): Detailed information of the requested MCP.\nstatus (string): Status of the operation (e.g., success or failure).\nerror (string): Error message in case the operation fails."
    },
