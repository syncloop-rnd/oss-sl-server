    "api_info" : {
      "title" : "Get One",
      "description" : "Retrieves details of a specific agent tool using its unique identifier (UUID). This operation returns the complete configuration and metadata of the requested tool.\n\nInput Parameters:\nuuid (string): Unique identifier of the agent tool to be retrieved.\n\nOutput Parameters:\nagent_tool (object): Detailed information of the requested agent tool.\nstatus (string): Status of the operation (e.g., success or failure). (if applicable in your backend)\nerror (string): Error message in case the operation fails. (if applicable)"
    },
