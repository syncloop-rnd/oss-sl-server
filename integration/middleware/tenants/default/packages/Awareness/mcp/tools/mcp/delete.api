    "api_info" : {
      "title" : "Delete MCP",
      "description" : "Deletes an MCP entry from the system using its unique identifier. This operation permanently removes the MCP along with its associated configurations, making it unavailable for further use.\n\nInput Parameters:\nid (string): Unique identifier of the MCP to be deleted.\n\nOutput Parameters:\ndeletedId (string): Identifier of the deleted MCP.\nstatus (string): Status of the operation (e.g., success or failure).\nerror (string): Error message in case the deletion fails."
    },
