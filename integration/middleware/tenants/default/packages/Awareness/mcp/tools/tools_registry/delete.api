    "api_info" : {
      "title" : "Delete",
      "description" : "Deletes a tool from the tool registry using its unique identifier. This operation permanently removes the tool from the registry, making it unavailable for association with agents or further usage within the system.\n\nInput Parameters:\nuuid (string): Unique identifier of the tool in the registry to be deleted.\n\nOutput Parameters:\nstatus (string): Status of the operation (e.g., success or failure).\nerror (string): Error message in case the deletion fails."
    },
