    "api_info" : {
      "title" : "Delete",
      "description" : "Deletes an existing agent tool from the system using its unique identifier (UUID). This operation permanently removes the tool and detaches it from any associated agents, making it unavailable for further use.\n\nInput Parameters:\nuuid (string): Unique identifier of the agent tool to be deleted.\n\nOutput Parameters:\nstatus (string): Status of the operation (e.g., success or failure).\nerror (string): Error message in case the deletion fails."
    },
