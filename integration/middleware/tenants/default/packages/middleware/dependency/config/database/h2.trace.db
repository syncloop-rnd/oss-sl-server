org.h2.jdbc.JdbcSQLSyntaxErrorException: Column "NAN" not found; SQL statement:
WITH ranked AS (
  SELECT *, ROW_NUMBER() OVER (PARTITION BY fqn ORDER BY id DESC) AS rn
  FROM audit_logging WHERE LOWER(fqn) LIKE '%wrapper.api%'
),
latest_logs AS (
  -- Select the latest record for each FQN (rn = 1)
  SELECT fqn, id, correlationId, duration, error, sessionId, dateTimeStmp, nodeName, 
  remoteAddr, urlPath, hostName, userId FROM ranked WHERE rn = 1
),
aggregated_details AS (
  -- Aggregate details for the top 5 records for each FQN
  SELECT fqn, LISTAGG(CONCAT(id, ',', correlationId, ',', error), '; ') 
  WITHIN GROUP (ORDER BY id DESC) AS details FROM ranked WHERE rn <= 5 GROUP BY fqn
)
SELECT l.fqn, l.id, l.correlationId, l.duration, l.error, l.sessionId, l.dateTimeStmp, 
l.nodeName, l.remoteAddr, l.urlPath, l.hostName, l.userId, a.details FROM latest_logs l
JOIN aggregated_details a ON l.fqn = a.fqn ORDER BY l.fqn
OFFSET NaN ROWS
FETCH NEXT 20 ROWS ONLY; [42122-232]
